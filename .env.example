# Environment Variables Template
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control

# ─────────────────────────────────────────────────────────
# LLM Provider for Chatbot
# Options: 'gemini' (default) | 'openai'
# ─────────────────────────────────────────────────────────
CYBERTECH_LLM_PROVIDER=gemini

# ─────────────────────────────────────────────────────────
# Google Gemini (if CYBERTECH_LLM_PROVIDER=gemini)
# Get key from: https://aistudio.google.com/app/apikey
# ─────────────────────────────────────────────────────────
CYBERTECH_GEMINI_API_KEY=your_gemini_api_key_here

# ─────────────────────────────────────────────────────────
# OpenAI (if CYBERTECH_LLM_PROVIDER=openai)
# Get key from: https://platform.openai.com/api-keys
# ─────────────────────────────────────────────────────────
CYBERTECH_OPENAI_API_KEY=your_openai_api_key_here
CYBERTECH_OPENAI_MODEL=gpt-4o-mini

# ─────────────────────────────────────────────────────────
# PostgreSQL Database (Required)
# Supported: Vercel Postgres, Supabase, Neon, Railway, Local Postgres
# ─────────────────────────────────────────────────────────
POSTGRES_URL=postgresql://user:password@hostname:5432/cybertech_db?sslmode=require

# ─────────────────────────────────────────────────────────
# Public Domain, SEO & Google Analytics (Optional / Recommended for Vercel)
# ─────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://cybertech-pnp.vercel.app
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your_google_site_verification_code
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX


