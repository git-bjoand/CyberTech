# Environment Variables Template
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control

# ─────────────────────────────────────────────────────────
# Admin Authentication & Security
# ─────────────────────────────────────────────────────────
# Secret key for HMAC-SHA256 session token generation and verification
ADMIN_SESSION_SECRET=generate_a_strong_random_32_character_secret_here
# Optional master/programmatic key for server-to-server calls via X-Admin-Secret
ADMIN_SECRET_KEY=your_admin_secret_key_here

# ─────────────────────────────────────────────────────────
# LLM Provider for Chatbot
# Options: 'groq' | 'gemini' | 'openai'
# ─────────────────────────────────────────────────────────
CYBERTECH_LLM_PROVIDER=gemini

# ─────────────────────────────────────────────────────────
# Groq AI (if CYBERTECH_LLM_PROVIDER=groq)
# Get key from: https://console.groq.com/keys
# ─────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ─────────────────────────────────────────────────────────
# Google Gemini (if CYBERTECH_LLM_PROVIDER=gemini)
# Get key from: https://aistudio.google.com/app/apikey
# ─────────────────────────────────────────────────────────
CYBERTECH_GEMINI_API_KEY=your_gemini_api_key_here

# ─────────────────────────────────────────────────────────
# OpenAI (if CYBERTECH_LLM_PROVIDER=openai)
# Get key from: https://platform.openai.com/api-keys
# ─────────────────────────────────────────────────────────
CYBERTECH_OPENAI_API_KEY=your_openai_api_key_here
CYBERTECH_OPENAI_MODEL=gpt-4o-mini

# ─────────────────────────────────────────────────────────
# PostgreSQL Database (Required)
# Supported: Vercel Postgres, Supabase, Neon, Railway, Local Postgres
# ─────────────────────────────────────────────────────────
POSTGRES_URL=postgresql://user:password@hostname:5432/cybertech_db?sslmode=require

# ─────────────────────────────────────────────────────────
# Payment Account Configuration (Optional - overrides DB default)
# ─────────────────────────────────────────────────────────
PAYMENT_BANK_NAME=BNI
PAYMENT_ACCOUNT_NUMBER=1868208198
PAYMENT_ACCOUNT_HOLDER=RahmaDani

# ─────────────────────────────────────────────────────────
# Public Domain, SEO & Google Analytics (Optional / Recommended for Vercel)
# ─────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://cybertech-pnp.vercel.app
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your_google_site_verification_code
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
